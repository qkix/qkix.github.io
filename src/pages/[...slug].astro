---
// Every page of the site, in both languages: English at /, Polish under /pl/ (owner, 17 Nov 2026: qkix.eu is the
// studio's home - what I make -, the games at /games/, the Strapi plugins at /strapi-plugins/, each in its own style).
//   /  /games/  /games/<game>/  /games/<game>/privacy-policy/  /games/<game>/test/  /games/<game>/roadmap/
//   /strapi-plugins/  /strapi-plugins/<plugin>/
// Short aliases that forward (owner, 17 Nov 2026): /g/<game>/, /g/<game>/pp/ (the policy - what the games show), /sp/<plugin>/.
// The old game addresses (/<game>/, /<game>/test/, /<game>/roadmap/) forward to /games/...; the old /<game>/privacy/
// keeps the whole policy (released builds and old store forms link it; a forwarding page is not a policy), with its
// canonical on /games/<game>/privacy-policy/ - the address the store forms give from 17 Nov 2026. /<game>/play/ (shorts' links) is src/pages/[game]/play.astro.
import Base from "../layouts/Base.astro";
import Studio from "../components/Studio.astro";
import Home from "../components/Home.astro";
import GamePage from "../components/GamePage.astro";
import Privacy from "../components/Privacy.astro";
import Test from "../components/Test.astro";
import Roadmap from "../components/Roadmap.astro";
import Plugins from "../components/Plugins.astro";
import PluginPage from "../components/PluginPage.astro";
import SitePrivacy from "../components/SitePrivacy.astro";
import { GAMES, LANGS, T, href, type Game, type Lang } from "../data/site";
import { PLUGINS, type Plugin } from "../data/plugins";

type View = "siteprivacy" | "studio" | "games" | "game" | "privacy" | "test" | "roadmap" | "plugins" | "plugin" | "moved";
interface Page { path: string; view: View; game?: Game; plugin?: Plugin; to?: string; canonical?: string }
export function getStaticPaths() {
  const pages: Page[] = [{ path: "", view: "studio" }, { path: "privacy-policy/", view: "siteprivacy" }, { path: "games/", view: "games" }, { path: "strapi-plugins/", view: "plugins" }];
  for (const game of GAMES) {
    const at = `games/${game.id}/`;
    pages.push({ path: at, view: "game", game });
    pages.push({ path: `${at}privacy-policy/`, view: "privacy", game });
    pages.push({ path: `${game.id}/`, view: "moved", game, to: at });
    pages.push({ path: `${game.id}/privacy/`, view: "privacy", game, canonical: `${at}privacy-policy/` });
    pages.push({ path: `g/${game.id}/`, view: "moved", game, to: at });                       // short aliases (in-game text,
    pages.push({ path: `g/${game.id}/pp/`, view: "moved", game, to: `${at}privacy-policy/` });  // bios): they forward
    if (game.test) {
      pages.push({ path: `${at}test/`, view: "test", game });
      pages.push({ path: `${game.id}/test/`, view: "moved", game, to: `${at}test/` });
    }
    if (game.roadmap) {
      pages.push({ path: `${at}roadmap/`, view: "roadmap", game });
      pages.push({ path: `${game.id}/roadmap/`, view: "moved", game, to: `${at}roadmap/` });
    }
  }
  for (const plugin of PLUGINS) {
    pages.push({ path: `strapi-plugins/${plugin.id}/`, view: "plugin", plugin });
    pages.push({ path: `sp/${plugin.id}/`, view: "moved", plugin, to: `strapi-plugins/${plugin.id}/` });
  }
  return LANGS.flatMap((lang) => pages.map((p) => ({
    params: { slug: ((lang === "en" ? "" : `${lang}/`) + p.path).replace(/\/$/, "") || undefined },
    props: { lang, ...p },
  })));
}
interface Props extends Page { lang: Lang }
const { lang, path, view, game, plugin, to, canonical } = Astro.props;
const t = T[lang];
const title = view === "game" ? game!.name
  : view === "privacy" ? `${game!.name} – ${t.pp_title}`
  : view === "test" ? `${game!.name} – ${t.t_title}`
  : view === "roadmap" ? `${game!.name} – ${t.rm_title}`
  : view === "siteprivacy" ? t.pp_title
  : view === "games" ? t.games_title
  : view === "plugins" ? t.plugins_title
  : view === "plugin" ? `${plugin!.name} – ${t.plugin_suffix}` : undefined;
const description = view === "game" || view === "test" || view === "roadmap" ? game!.tag[lang]
  : view === "games" ? t.description_games
  : view === "plugins" ? t.description_plugins
  : view === "plugin" ? plugin!.tag[lang] : undefined;
const image = game ? `/${game.id}/feature.png` : view === "studio" || view === "plugins" || view === "plugin" ? "/brand/card.png" : undefined;
const target = to ? href(lang, to) : "";
const style = view === "plugins" || view === "plugin" ? "dev" : view === "studio" ? "studio" : "games";
---
{view === "moved" ? (
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{(game ?? plugin)!.name} – qkix</title>
  <meta http-equiv="refresh" content={`0; url=${target}`}>
  <link rel="canonical" href={new URL(target, Astro.site).href}>
  <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
  <style>body{background:#171a24;color:#fff;font:16px system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0}a{color:#f5d46b}</style>
</head>
<body><p><a href={target}>{(game ?? plugin)!.name}</a></p></body>
</html>
) : (
<Base lang={lang} path={path} title={title} description={description} image={image} style={style} canonical={canonical}>
  {view === "studio" && <Studio lang={lang} />}
  {view === "siteprivacy" && <SitePrivacy lang={lang} />}
  {view === "games" && <Home lang={lang} />}
  {view === "game" && <GamePage lang={lang} game={game!} />}
  {view === "privacy" && <Privacy lang={lang} game={game!} />}
  {view === "test" && <Test lang={lang} game={game!} />}
  {view === "roadmap" && <Roadmap lang={lang} game={game!} />}
  {view === "plugins" && <Plugins lang={lang} />}
  {view === "plugin" && <PluginPage lang={lang} plugin={plugin!} />}
</Base>
)}
