---
// The closed-test sign-up page of a game in testing (Game.test links).
import { T, href, type Game, type Lang } from "../data/site";
import { asset } from "../lib/asset";
import GameHead from "./GameHead.astro";

interface Props { lang: Lang; game: Game }
const { lang, game } = Astro.props;
const t = T[lang];
const links = [game.test!.group, game.test!.optIn, game.test!.store];
const shotLang = game.shotLangs.includes(lang) ? lang : "en";
const steps = [[t.t1, t.t1p, t.t1b], [t.t2, t.t2p, t.t2b], [t.t3, t.t3p, t.t3b]];
---
<GameHead lang={lang} game={game} title={t.t_title} line={(game.test!.ios ? t.t_lead_ios : t.t_lead).replace("{name}", game.name)} />
<div class="wrap" style={`--accent:${game.accent};padding-block:26px 30px`}>
  {game.test!.ios && (
    <h2 class="eyebrow" style="margin:0 0 10px">{t.t_iphone}</h2>
    <div class="steps" style="margin-bottom:26px">
      <div class="stepc"><span class="n">1</span><h3>TestFlight</h3><p>{t.ti_p}</p>
        <a class="btn" href={game.test!.ios} target="_blank" rel="noopener">{t.ti_b}</a>
        <a class="btn ghost" href="https://apps.apple.com/app/testflight/id899247664" target="_blank" rel="noopener" style="margin-top:8px">{t.ti_store}</a></div>
    </div>
    <h2 class="eyebrow" style="margin:0 0 10px">{t.t_android}</h2>
  )}
  <div class="steps">
    {steps.map(([h, p, b], i) => (
      <div class="stepc"><span class="n">{i + 1}</span><h3>{h}</h3><p>{p}</p>
        <a class={i === 2 ? "btn ghost" : "btn"} href={links[i]} target="_blank" rel="noopener">{b}</a></div>
    ))}
  </div>
  <p class="warn" set:html={t.t_warn} />
  <p class="note">{t.t_tip}</p>
  <div class="tshots" data-shots>
    {game.shots.slice(0, 3).map((s) => <img class="px" src={asset(`/${game.id}/shots/${shotLang}/${s}.png`)} alt="" width="360" height="640" loading="lazy">)}
  </div>
  <p style="margin-top:20px"><a href={href(lang, `${game.id}/privacy/`)}>{t.privacy}</a> · <a href={href(lang, `${game.id}/`)}>{game.name}</a></p>
</div>
